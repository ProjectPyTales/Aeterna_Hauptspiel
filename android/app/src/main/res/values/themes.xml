<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Vollbild bis in die Kamera-Aussparung; die WebView kennt die sicheren Ränder (window.safeInsets). -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:statusBarColor">@color/hall</item>
        <item name="android:navigationBarColor">@color/hall</item>
    </style>
</resources>
