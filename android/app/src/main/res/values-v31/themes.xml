<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: System-Splash mit dem Aeterna-Zeichen; er bleibt, bis der Ladebildschirm der Seite steht. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hall</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:statusBarColor">@color/hall</item>
        <item name="android:navigationBarColor">@color/hall</item>
        <item name="android:windowSplashScreenBackground">@color/hall</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
